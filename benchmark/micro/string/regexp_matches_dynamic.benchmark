# name: benchmark/micro/string/regexp_matches_dynamic.benchmark
# description: regexp_matches with a pattern column holding a handful of distinct patterns
# group: [string]

name Regexp Matches Dynamic Pattern
group string

load
CREATE TABLE regex_data AS
SELECT 'string number ' || i AS s,
       CASE i % 4 WHEN 0 THEN '[0-9]+' WHEN 1 THEN '[a-z]+' WHEN 2 THEN 'num[a-z]*' ELSE '^[0-9]+$' END AS p
FROM range(10000000) t(i);

run
SELECT SUM(regexp_matches(s, p)::INT) FROM regex_data

result I
7500000
