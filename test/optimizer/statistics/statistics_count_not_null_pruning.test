# name: test/optimizer/statistics/statistics_count_not_null_pruning.test
# description: Prune columns made unused by aggregate statistics rewrites
# group: [statistics]

statement ok
PRAGMA explain_output = PHYSICAL_ONLY

statement ok
CREATE TABLE events(user_id INTEGER NOT NULL, session_id INTEGER, device_type VARCHAR)

statement ok
INSERT INTO events VALUES (1, NULL, 'Desktop'), (2, 2, 'Mobile')

query II
EXPLAIN SELECT device_type, count(user_id) FROM events GROUP BY device_type
----
physical_plan	<!REGEX>:.*user_id.*

query TII
SELECT device_type, count(user_id), count(session_id)
FROM events GROUP BY device_type ORDER BY device_type
----
Desktop	1	0
Mobile	1	1

statement ok
CREATE TABLE cs(a INTEGER, b INTEGER NOT NULL)

statement ok
INSERT INTO cs SELECT i, i FROM range(3) t(i)

query II
SELECT * FROM (
    SELECT a, (SELECT count(b) FROM cs) AS c FROM cs
    UNION ALL
    SELECT a, (SELECT count(b) FROM cs) AS c FROM cs
) ORDER BY 1, 2
----
0	3
0	3
1	3
1	3
2	3
2	3

statement ok
CREATE TABLE counted AS
SELECT {'id': k + 1000, 'my_struct': {'a': k, 'b': k + 30}} AS v,
	   k AS not_null_col
FROM range(5) t(k)

query III
SELECT (v.my_struct::STRUCT(b VARCHAR, a VARCHAR)).b AS g,
	   count(not_null_col), count(DISTINCT not_null_col)
FROM counted GROUP BY g ORDER BY g
----
30	1	1
31	1	1
32	1	1
33	1	1
34	1	1

statement ok
CREATE TABLE distinct_values(value INTEGER NOT NULL)

statement ok
INSERT INTO distinct_values VALUES (1), (1), (2)

query I
SELECT count(DISTINCT value) FROM distinct_values
----
2

query II
EXPLAIN SELECT count(DISTINCT value) AS count_distinct FROM distinct_values
----
physical_plan	<REGEX>:.*count_star\(\).*Projections: 42.*

statement ok
CREATE TABLE jl(id INTEGER NOT NULL, counted INTEGER NOT NULL, payload INTEGER)

statement ok
CREATE TABLE jr(id INTEGER NOT NULL, counted INTEGER NOT NULL, payload INTEGER)

statement ok
INSERT INTO jl VALUES (1, 101, 10), (2, 102, 20), (3, 103, 30)

statement ok
INSERT INTO jr VALUES (1, 201, 100), (2, 202, 200)

query IIII
SELECT count(jl.counted), sum(jl.payload), count(jr.counted), sum(jr.payload)
FROM jl JOIN jr USING (id)
----
2	30	2	300

query II
EXPLAIN
SELECT count(jl.counted) AS lc, sum(jl.payload) AS ls,
	   count(jr.counted) AS rc, sum(jr.payload) AS rs
FROM jl JOIN jr USING (id)
----
physical_plan	<!REGEX>:.*counted.*
